rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null && firestore.get(
        /databases/(default)/documents/users/$(request.auth.uid)
      ).data.role == 'admin';
    }

    match /products_images/{imageId} {
      allow read;
      allow write: if isAdmin();
    }

    match /payments/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }

  }
}